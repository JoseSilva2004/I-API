# Configuración del Servidor
PORT=3100
NODE_ENV=development

# Llave Maestra de Administración (Obligatoria, mínimo 32 caracteres aleatorios)
ADMIN_MASTER_KEY=GENERAR_LLAVE_SECRETA_DE_MINIMO_32_CARACTERES_AQUI

# Credenciales de PostgreSQL
POSTGRES_USER=iapi_user
POSTGRES_PASSWORD=CAMBIAR_POR_CLAVE_SEGURA_AQUI
POSTGRES_DB=iapi_db

# Conexión a PostgreSQL (Interna de Docker)
DATABASE_URL="postgresql://iapi_user:CAMBIAR_POR_CLAVE_SEGURA_AQUI@iapi-db:5432/iapi_db?schema=public"

# Parámetros Anti-Baneo (En milisegundos)
IDLE_THRESHOLD_MS=120000
FAST_TYPING_MIN_MS=1800
FAST_TYPING_MAX_MS=8500
BURST_DELAY_MIN_MS=20000
BURST_DELAY_MAX_MS=45000

# Opciones de Comportamiento de Mensajes
AUTO_READ_MESSAGES=false
HUMANIZE_MESSAGES=false

# Canal de Alerta Administrativa en Telegram (Opcional)
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
