{
  "name": "i-api",
  "version": "1.0.0",
  "description": "API Omnicanal de Mensajeria con Cola Anti-Baneo y Persistencia en PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:smoke": "node --test tests/smoke/*.test.mjs",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@whiskeysockets/baileys": "6.7.24",
    "dotenv": "16.6.1",
    "fastify": "4.29.1",
    "grammy": "1.46.0",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
    "prisma": "5.22.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
